# ---- App (Expo public: lo lọt ra client là chấp nhận được) ----
# Dev local: URL http://127.0.0.1:54321 + khoá anon từ `pnpm exec supabase status`;
# emulator/máy thật cần `adb reverse tcp:54321 tcp:54321`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=

# ---- Server: CHỈ đặt trong Supabase secrets / Railway, KHÔNG BAO GIỜ có tiền tố EXPO_PUBLIC ----
SUPABASE_SERVICE_ROLE_KEY=
LLM_PROVIDER_API_KEY=
LLM_MODEL_ANSWER=gemini-3.5-flash-lite      # tầng free (và khi ngắt mạch)
LLM_MODEL_ANSWER_PRO=gemini-3.5-flash       # tầng pro/dùng thử; đặt = lite khi còn free tier Gemini (20 lượt/ngày)
LLM_MODEL_RERANK=gemini-3.5-flash-lite
LLM_MODEL_VERIFY=gemini-3.5-flash-lite
LLM_MODEL_QUIZ=gemini-3.5-flash   # sinh một lần rồi lưu; lên bản pro khi bật billing (#7)
LLM_MODEL_GRADE=gemini-3.5-flash   # chấm tự luận: model mạnh nhất có quota kiểm được (ADR-0001); thử 3.8-flash khi bật billing
EMBEDDING_MODEL=gemini-embedding-2
INGEST_SERVICE_URL=
INGEST_SERVICE_TOKEN=

# ---- Trần chi phí ----
DAILY_COST_CEILING_USD_PER_USER=0.35
MAX_CONTEXT_CHUNKS=6
MAX_ANSWER_TOKENS=700

# Sentry: chỉ cần khi upload sourcemap lúc build release
SENTRY_AUTH_TOKEN=

# services/ingest (URL public khi deploy Railway; local: http://127.0.0.1:8000 + adb reverse tcp:8000)
EXPO_PUBLIC_INGEST_URL=

# G6 — RevenueCat (app dùng Public API key; webhook dùng secret đặt ở RevenueCat → Integrations → Webhooks)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
REVENUECAT_WEBHOOK_SECRET=
