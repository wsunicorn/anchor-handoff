{
  "name": "anchor",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "test": "vitest run",
    "test:rls": "bash scripts/test-rls.sh",
    "db:start": "supabase start -x logflare,vector,imgproxy,supavisor,realtime",
    "db:reset": "supabase db reset",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"supabase/tests/**/*.ts\" \"*.{js,mjs,mts,ts,json}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.0",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^4.70.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19"
  }
}
